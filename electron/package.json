{
  "name": "electron-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "dev": "npm run build && KLUDGE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "game": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "electron": "^43.1.0",
    "typescript": "^5.7.3"
  }
}
